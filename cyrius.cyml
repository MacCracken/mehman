[package]
name = "mehman"
version = "${file:VERSION}"
description = "mehman — sovereign compat/swallow surface backend for the AGNOS compositor (hosts foreign-app surfaces in a kavach sandbox)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.3.5"

[build]
entry = "programs/smoke.cyr"
output = "build/mehman-smoke"

[lib]
modules = ["src/main.cyr"]

[deps]
# mehman's own stdlib (assert/bench for tests + benches) unioned with kavach's
# transitive stdlib — REQUIRED to link the kavach dist bundle. Its
# dist/kavach.deps sidecar lists only kavach's *direct* leaves; a consumer that
# omits the full transitive set fails to LINK (undefined thread_local_* /
# sandhi_server_* / async_* / TLS_BACKEND_LIBSSL). Mirrors kavach's own
# [deps].stdlib. See kavach README "Consume kavach as a library".
stdlib = [
    "alloc", "assert", "async", "bayan", "bench", "chrono", "ct", "dynlib",
    "fdlopen", "fmt", "fnptr", "freelist", "fs", "hashmap", "hashmap_fast",
    "io", "keccak", "mmap", "net", "process", "random", "result", "sandhi",
    "slice", "str", "string", "syscalls", "tagged", "thread", "thread_local",
    "tls", "vec",
]

# kavach 3.6.0 — the sandbox-execution surface M1 drives. Consumed as the
# committed single-file dist bundle (materialized into lib/kavach.cyr by
# `cyrius deps`); source-included via src/main.cyr's chain. See ADR 0001.
[deps.kavach]
git     = "https://github.com/MacCracken/kavach.git"
path    = "../kavach"
tag     = "3.6.0"
modules = ["dist/kavach.cyr"]
