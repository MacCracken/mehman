# mehman — M4 guest lifecycle
#
# The single backend handle the compositor drives. A MehmanGuest bundles the
# swallow-stage pieces the earlier milestones built — the guest spec (M1), the
# foreign surface (M2), and the target ABI (M3) — behind a small lifecycle:
# spawn → map → run → evict. aethersafha holds one of these per hosted foreign
# app and drives it under compositor control; this is mehman's real public
# surface (it retires the scaffold sentinel).
#
# Requires the earlier modules in scope (types / surface / shim / sandbox); like
# sandbox.cyr, `guest_run` uses kavach, so this module rides the `sandbox`
# feature — the create/map/evict + accessors are otherwise pure state.

# Lifecycle state of a hosted guest.
enum MehmanGuestState {
    GUEST_CREATED = 0;   # spawned; no compositor window yet
    GUEST_MAPPED  = 1;   # the compositor has mapped a window for it
    GUEST_RUNNING = 2;   # has run at least once (surface captured)
    GUEST_EVICTED = 3;   # torn down; terminal
}

# The backend handle. Fields (all i64): spec (MehmanGuestSpec*), surface
# (MehmanSurface*), abi (MehmanAbi), state (MehmanGuestState), exit_code (last
# run's kavach exec status, or -1 before the first run), handle (a live kavach
# PersistentGuest* for the M3 delivery path, or 0 when not started).
#derive(accessors)
struct MehmanGuest {
    spec;
    surface;
    abi;
    state;
    exit_code;
    handle;
}
var MEHMAN_GUEST_SIZE = 48;   # 6 fields x 8 bytes

# guest_spawn(command, w, h): build a swallow-stage guest — its spec (swallow
# caps: non-native, mediated I/O) + a fresh w×h XRGB8888 surface + the swallow
# ABI, in the CREATED state. -> MehmanGuest* (0 on an invalid spec/surface or OOM).
fn guest_spawn(command, w, h) {
    var spec = guest_spec_new(command, caps_swallow_default());
    if (guest_spec_is_valid(spec) == 0) { return 0; }
    var stride = w * mehman_format_bpp(MehmanPixelFormat.XRGB8888);
    var buffer = alloc(stride * h);
    if (buffer == 0) { return 0; }
    var surface = surface_new(w, h, MehmanPixelFormat.XRGB8888, stride, buffer);
    if (surface_is_valid(surface) == 0) { return 0; }
    var g = alloc(MEHMAN_GUEST_SIZE);
    if (g == 0) { return 0; }
    MehmanGuest_set_spec(g, spec);
    MehmanGuest_set_surface(g, surface);
    MehmanGuest_set_abi(g, MehmanAbi.ABI_SWALLOW);
    MehmanGuest_set_state(g, MehmanGuestState.GUEST_CREATED);
    MehmanGuest_set_exit_code(g, 0 - 1);
    MehmanGuest_set_handle(g, 0);
    return g;
}

fn guest_spec(g)      { return MehmanGuest_spec(g); }
fn guest_surface(g)   { return MehmanGuest_surface(g); }
fn guest_abi(g)       { return MehmanGuest_abi(g); }
fn guest_state(g)     { return MehmanGuest_state(g); }
fn guest_exit_code(g) { return MehmanGuest_exit_code(g); }
fn guest_handle(g)    { return MehmanGuest_handle(g); }

# guest_map(g): the compositor has mapped a window for this guest. CREATED/MAPPED
# → MAPPED. -> MehmanError.OK, or INVALID_SPEC for a null or already-evicted guest.
fn guest_map(g): i64 {
    if (g == 0) { return MehmanError.INVALID_SPEC; }
    if (MehmanGuest_state(g) == MehmanGuestState.GUEST_EVICTED) { return MehmanError.INVALID_SPEC; }
    MehmanGuest_set_state(g, MehmanGuestState.GUEST_MAPPED);
    return MehmanError.OK;
}

# guest_run(g): launch the guest under a kavach PROCESS sandbox and capture its
# surface (the M2 handoff), recording the exec status and, on success,
# transitioning to RUNNING. -> the MehmanError from the run (INVALID_SPEC for a
# null or evicted guest, without touching kavach). A guest killed at its deadline
# returns GUEST_TIMED_OUT with its status recorded and stays in its state: it has
# been reaped, so it is not RUNNING, and it may be run again or evicted.
fn guest_run(g): i64 {
    if (g == 0) { return MehmanError.INVALID_SPEC; }
    if (MehmanGuest_state(g) == MehmanGuestState.GUEST_EVICTED) { return MehmanError.INVALID_SPEC; }
    var exit = 0;
    var r = mehman_sandbox_capture_guest(MehmanGuest_spec(g), MehmanGuest_surface(g), &exit);
    MehmanGuest_set_exit_code(g, exit);
    if (r == MehmanError.OK) {
        MehmanGuest_set_state(g, MehmanGuestState.GUEST_RUNNING);
    }
    return r;
}

# --- M3 live delivery (persistent guest) ------------------------------------
# The one-shot guest_run captures a guest that exits. The delivery path instead
# keeps the guest LIVE (kavach 3.7.0 persistent execution) so the compositor can
# stream input/resize events to it via the M3 shim.

# guest_start(g): launch the guest as a PERSISTENT kavach process with live
# stdin/stdout, storing the live handle and transitioning to RUNNING. -> OK, or
# SANDBOX_CREATE_FAILED if the spawn failed, INVALID_SPEC for a null/evicted guest.
#
# The guest runs under `policy_basic()`, the policy a one-shot guest gets from
# `config_new()`. ⛔ Do not go back to `persistent_spawn`: it applies no seccomp, no
# landlock and no capability bound, whatever the caller holds. Through v1.1.1 this
# called it, so a live guest had the host's network and no filter. See ADR 0009.
fn guest_start(g): i64 {
    if (g == 0) { return MehmanError.INVALID_SPEC; }
    if (MehmanGuest_state(g) == MehmanGuestState.GUEST_EVICTED) { return MehmanError.INVALID_SPEC; }
    if (guest_spec_is_valid(MehmanGuest_spec(g)) == 0) { return MehmanError.INVALID_SPEC; }
    _mehman_kavach_ensure_init();
    var h = persistent_spawn_confined(MehmanGuestSpec_command(MehmanGuest_spec(g)), policy_basic());
    if (h == 0) {
        mehman_err_print(MehmanError.SANDBOX_CREATE_FAILED, 0);
        return MehmanError.SANDBOX_CREATE_FAILED;
    }
    MehmanGuest_set_handle(g, h);
    MehmanGuest_set_state(g, MehmanGuestState.GUEST_RUNNING);
    return MehmanError.OK;
}

# SIGPIPE's bit in a kernel sigset (signal 13, so bit 12).
const _MEHMAN_SIGPIPE_BIT = 0x1000;

# Write wire bytes to a live guest's stdin. -> bytes written, or < 0. Private.
#
# A guest can exit on its own at any moment, and a write to its closed stdin raises
# SIGPIPE, whose default action kills the writer: an untrusted guest could end the
# compositor by exiting. So SIGPIPE is blocked on this thread for the write and, if
# the write raised it, taken before the caller's mask comes back. Measured before
# this existed: the next event sent to a guest that had exited killed the host, 141.
#
# ⛔ Not `signal_ignore(SIGPIPE)`. SIG_IGN is process-wide, overrides a consumer's
# own handling, and survives execve, so every guest started afterwards would inherit
# it and see EPIPE where it would have died. This is the pattern lib/tls.cyr uses
# for the same reason. A SIGPIPE the caller already had blocked is left to the caller.
fn _guest_write(h, bytes, n): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    var set[8];
    var old[8];
    store64(&set, _MEHMAN_SIGPIPE_BIT);
    store64(&old, 0);
    if (sys_sigprocmask(0, &set, &old) == 0) {          # SIG_BLOCK
        var r = persistent_send(h, bytes, n);
        if ((r == (0 - 32)) && ((load64(&old) & _MEHMAN_SIGPIPE_BIT) == 0)) {   # -EPIPE
            var ts[16];                                 # 16 BYTES: {0 s, 0 ns}
            store64(&ts, 0);
            store64(&ts + 8, 0);
            #ifdef CYRIUS_ARCH_X86
            syscall(128, &set, 0, &ts, 8);              # rt_sigtimedwait
            #endif
            #ifdef CYRIUS_ARCH_AARCH64
            syscall(137, &set, 0, &ts, 8);              # rt_sigtimedwait
            #endif
        }
        sys_sigprocmask(2, &old, 0);                    # SIG_SETMASK
        return r;
    }
    #endif
    return persistent_send(h, bytes, n);
}

# guest_send_input(g, event): translate an input event through the shim (M3) and
# deliver its wire bytes to the live guest's stdin. -> OK, INVALID_SPEC (null
# guest / unsupported ABI / bad event), or EXEC_FAILED (guest not started, or gone).
fn guest_send_input(g, event): i64 {
    if (g == 0) { return MehmanError.INVALID_SPEC; }
    var h = MehmanGuest_handle(g);
    if (h == 0) { return MehmanError.EXEC_FAILED; }
    var wire[16];
    var n = shim_encode_input(MehmanGuest_abi(g), event, &wire);
    if (n == 0) { return MehmanError.INVALID_SPEC; }
    if (_guest_write(h, &wire, n) < 0) { return MehmanError.EXEC_FAILED; }
    return MehmanError.OK;
}

# guest_send_resize(g, w, h): translate + deliver a resize event to the live guest.
# Same returns as guest_send_input.
fn guest_send_resize(g, w, h): i64 {
    if (g == 0) { return MehmanError.INVALID_SPEC; }
    var handle = MehmanGuest_handle(g);
    if (handle == 0) { return MehmanError.EXEC_FAILED; }
    var wire[16];
    var n = shim_encode_resize(MehmanGuest_abi(g), w, h, &wire);
    if (n == 0) { return MehmanError.INVALID_SPEC; }
    if (_guest_write(handle, &wire, n) < 0) { return MehmanError.EXEC_FAILED; }
    return MehmanError.OK;
}

# guest_read(g, buf, len): read up to len bytes of the live guest's output
# (blocking). -> bytes read, or -1 for a null / not-started guest.
fn guest_read(g, buf, len): i64 {
    if (g == 0) { return 0 - 1; }
    var h = MehmanGuest_handle(g);
    if (h == 0) { return 0 - 1; }
    return persistent_read(h, buf, len);
}

# guest_evict(g): tear the guest down. Terminates + reaps the live persistent
# handle if one is running. Any state → EVICTED (terminal, idempotent).
# -> MehmanError.OK, or INVALID_SPEC for a null guest.
fn guest_evict(g): i64 {
    if (g == 0) { return MehmanError.INVALID_SPEC; }
    var h = MehmanGuest_handle(g);
    if (h != 0) {
        persistent_terminate(h);
        MehmanGuest_set_handle(g, 0);
    }
    MehmanGuest_set_state(g, MehmanGuestState.GUEST_EVICTED);
    return MehmanError.OK;
}
