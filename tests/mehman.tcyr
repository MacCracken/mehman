# mehman test suite
# Stdlib auto-included via cyrius.cyml. src/main.cyr is source-included so the
# tests can name types.cyr's enum/var constants (MehmanError.*, MEHMAN_*_SIZE):
# under `cyrius test` the [lib].modules are linked (functions become global
# symbols) but enum/var constants are only visible to a file that source-
# includes the module.
include "src/main.cyr"

fn main() {
    alloc_init();

    test_group("smoke");
    assert(1, "true is true");
    assert_eq(1 + 1, 2, "math works");

    # ----- types.cyr — error namespace ----------------------------------
    test_group("types.cyr — error namespace");
    assert_neq(mehman_err_name(MehmanError.OK), 0, "err_name(OK) non-null");
    assert_neq(mehman_err_name(MehmanError.INVALID_SPEC), 0, "err_name(INVALID_SPEC) non-null");
    assert_neq(mehman_err_name(MehmanError.EXEC_BLOCKED), 0, "err_name(EXEC_BLOCKED) non-null");
    assert_neq(mehman_err_name(99), 0, "err_name(unknown) non-null");
    assert_eq(mehman_err_print(MehmanError.OK, 0), 0, "err_print returns 0");

    # ----- types.cyr — bounded capability set ---------------------------
    test_group("types.cyr — capability set");
    var c = caps_swallow_default();
    assert_neq(c, 0, "swallow caps allocate");
    assert_eq(MehmanCaps_native_protocol(c), 0, "swallow denies native protocol");
    assert_eq(MehmanCaps_mediated_io(c), 1, "swallow mediates i/o");
    assert_eq(caps_is_swallow_valid(c), 1, "default swallow caps are valid");

    # native-protocol access must be rejected
    MehmanCaps_set_native_protocol(c, 1);
    assert_eq(caps_is_swallow_valid(c), 0, "native-protocol access is rejected");
    # unmediated i/o must be rejected
    MehmanCaps_set_native_protocol(c, 0);
    MehmanCaps_set_mediated_io(c, 0);
    assert_eq(caps_is_swallow_valid(c), 0, "unmediated i/o is rejected");
    # a null capability set is never valid
    assert_eq(caps_is_swallow_valid(0), 0, "null caps are invalid");

    # ----- types.cyr — guest spec ---------------------------------------
    test_group("types.cyr — guest spec");
    var g = guest_spec_new("/bin/true", caps_swallow_default());
    assert_neq(g, 0, "guest spec allocates");
    assert_eq(MehmanGuestSpec_command(g), "/bin/true", "command round-trips");
    assert_eq(guest_spec_is_valid(g), 1, "well-formed spec is valid");
    # an empty command line is rejected
    assert_eq(guest_spec_is_valid(guest_spec_new("", caps_swallow_default())), 0, "empty command rejected");
    # a spec with no capability set is rejected
    assert_eq(guest_spec_is_valid(guest_spec_new("/bin/true", 0)), 0, "null caps rejected");
    # a spec whose caps grant native access is rejected
    var bad = caps_swallow_default();
    MehmanCaps_set_native_protocol(bad, 1);
    assert_eq(guest_spec_is_valid(guest_spec_new("/bin/true", bad)), 0, "spec with native-access caps rejected");
    # a null spec is rejected
    assert_eq(guest_spec_is_valid(0), 0, "null spec rejected");

    # ----- sandbox.cyr — M1 sandboxed foreign host ----------------------
    test_group("sandbox.cyr — M1 host (kavach PROCESS backend)");
    # invalid specs are rejected before any kavach runtime is initialized
    assert_eq(mehman_sandbox_run_guest(0, 0), MehmanError.INVALID_SPEC, "host rejects null spec");
    assert_eq(mehman_sandbox_run_guest(guest_spec_new("", caps_swallow_default()), 0), MehmanError.INVALID_SPEC, "host rejects empty command");
    # M1 acceptance: a trivial foreign binary runs sandboxed and is reaped cleanly
    var code_slot = alloc(8);
    store64(code_slot, 0 - 1);
    var spec = guest_spec_new("/bin/true", caps_swallow_default());
    assert_eq(mehman_sandbox_run_guest(spec, code_slot), MehmanError.OK, "trivial foreign binary runs + reaps clean");
    assert_eq(load64(code_slot), 0, "kavach exec status 0 (ran + output captured)");
    # a second, distinct foreign binary also runs + reaps cleanly, and its captured
    # status is now the guest's REAL exit code: /bin/false exits 1, and mehman
    # reports 1. ⚠ This assertion read `0` until v1.0.2 and was CORRECT then —
    # kavach's PROCESS backend discarded WEXITSTATUS until kavach 3.11.4 routed
    # both the confined and unconfined paths through `confine_capture`. mehman's
    # declared tag was 3.11.0, four patches behind, so the old expectation stayed
    # green in CI while the local `path = "../kavach"` build had already flipped.
    # Do not "restore" the 0 — a sandbox host that cannot tell a failed guest from
    # a successful one is the defect kavach fixed. See CHANGELOG 1.0.2.
    store64(code_slot, 0 - 1);
    assert_eq(mehman_sandbox_run_guest(guest_spec_new("/bin/false", caps_swallow_default()), code_slot), MehmanError.OK, "second foreign binary runs + reaps clean");
    assert_eq(load64(code_slot), 1, "guest's real WEXITSTATUS is propagated (/bin/false -> 1)");

    # ----- surface.cyr — M2 surface descriptor foundation ---------------
    test_group("surface.cyr — M2 foreign-surface descriptor");
    assert_eq(mehman_format_bpp(MehmanPixelFormat.XRGB8888), 4, "XRGB8888 is 4 bpp");
    assert_eq(mehman_format_bpp(99), 0, "unknown format has 0 bpp");
    # stand-in for the captured pixel buffer (the shared-memory handoff is deferred)
    var pixbuf = alloc(64);
    var surf = surface_new(4, 3, MehmanPixelFormat.XRGB8888, 16, pixbuf);  # stride 16 = 4px * 4bpp
    assert_neq(surf, 0, "surface allocates");
    assert_eq(MehmanSurface_width(surf), 4, "width round-trips");
    assert_eq(MehmanSurface_height(surf), 3, "height round-trips");
    assert_eq(MehmanSurface_stride(surf), 16, "stride round-trips");
    assert_eq(surface_is_valid(surf), 1, "well-formed XRGB8888 surface is valid");
    assert_eq(surface_size_bytes(surf), 48, "size = stride * height");
    # rejection paths
    assert_eq(surface_is_valid(0), 0, "null surface invalid");
    assert_eq(surface_is_valid(surface_new(0, 3, MehmanPixelFormat.XRGB8888, 16, pixbuf)), 0, "zero width rejected");
    assert_eq(surface_is_valid(surface_new(4, 0, MehmanPixelFormat.XRGB8888, 16, pixbuf)), 0, "zero height rejected");
    assert_eq(surface_is_valid(surface_new(20000, 3, MehmanPixelFormat.XRGB8888, 80000, pixbuf)), 0, "oversized dimension rejected");
    assert_eq(surface_is_valid(surface_new(4, 3, 99, 16, pixbuf)), 0, "unknown format rejected");
    assert_eq(surface_is_valid(surface_new(4, 3, MehmanPixelFormat.XRGB8888, 8, pixbuf)), 0, "stride < width*bpp rejected");
    assert_eq(surface_is_valid(surface_new(4, 3, MehmanPixelFormat.XRGB8888, 16, 0)), 0, "null buffer rejected");

    # surface_blit_bytes — the dep-free capture sink: copy + clamp + zero-fill
    var bb = alloc(16);
    var bsurf = surface_new(2, 2, MehmanPixelFormat.XRGB8888, 8, bb);   # 16-byte buffer
    assert_eq(surface_blit_bytes(bsurf, "XY", 2), 2, "blit copies 2 bytes");
    assert_eq(load8(bb + 0), 88, "blit byte 0 = 'X'");
    assert_eq(load8(bb + 1), 89, "blit byte 1 = 'Y'");
    assert_eq(load8(bb + 2), 0, "blit zero-fills the tail");
    var longsrc = alloc(32);
    var k = 0; while (k < 32) { store8(longsrc + k, 70); k = k + 1; }   # 32 bytes of 'F'
    assert_eq(surface_blit_bytes(bsurf, longsrc, 9999), 16, "blit clamps len to buffer size");
    assert_eq(load8(bb + 15), 70, "clamped blit filled the whole buffer");
    assert_eq(surface_blit_bytes(bsurf, 0, 5), 0, "null src blits nothing");
    assert_eq(load8(bb + 0), 0, "null src zeroed the buffer");

    # ----- sandbox.cyr — M2 capture handoff (guest output → surface) -----
    test_group("sandbox.cyr — M2 capture (swallow handoff)");
    var capbuf = alloc(64);
    var capsurf = surface_new(4, 4, MehmanPixelFormat.XRGB8888, 16, capbuf);   # 64-byte buffer
    assert_neq(capsurf, 0, "capture surface allocates");
    var capexit = alloc(8);
    # /bin/echo AB writes "AB\n" to stdout → mehman captures it into the surface buffer
    assert_eq(mehman_sandbox_capture_guest(guest_spec_new("/bin/echo AB", caps_swallow_default()), capsurf, capexit), MehmanError.OK, "capture runs + reaps clean");
    assert_eq(load8(capbuf + 0), 65, "captured byte 0 = 'A' (echo stdout)");
    assert_eq(load8(capbuf + 1), 66, "captured byte 1 = 'B'");
    assert_eq(load8(capbuf + 2), 10, "captured byte 2 = newline");
    assert_eq(load8(capbuf + 3), 0, "byte 3 zero-filled past captured output");
    # capture rejects an invalid surface before touching kavach
    assert_eq(mehman_sandbox_capture_guest(guest_spec_new("/bin/true", caps_swallow_default()), 0, 0), MehmanError.INVALID_SPEC, "capture rejects null surface");

    # ----- shim.cyr — M3 event translation (compositor → guest wire) -----
    test_group("shim.cyr — M3 per-ABI event translation");
    var wire = alloc(16);
    # key: HID_ESC (0x29) pressed → [0x01, 0x29, 1]
    var ke = shim_input_key(0x29, 1);
    assert_neq(ke, 0, "key event allocates");
    assert_eq(MehmanInputEvent_kind(ke), MehmanInputKind.INPUT_KEY, "input kind = KEY");
    assert_eq(shim_encode_input(MehmanAbi.ABI_SWALLOW, ke, wire), 3, "key encodes to 3 bytes");
    assert_eq(load8(wire + 0), 0x01, "key wire tag");
    assert_eq(load8(wire + 1), 0x29, "key code = HID_ESC");
    assert_eq(load8(wire + 2), 1, "key pressed");
    # pointer motion (300, 200) → [0x03, x:u16 LE, y:u16 LE]
    var pm = shim_input_pointer_motion(300, 200);
    assert_eq(shim_encode_input(MehmanAbi.ABI_SWALLOW, pm, wire), 5, "motion encodes to 5 bytes");
    assert_eq(load8(wire + 0), 0x03, "motion wire tag");
    assert_eq(load8(wire + 1), 44, "motion x lo (300 & 0xFF)");
    assert_eq(load8(wire + 2), 1, "motion x hi (300 >> 8)");
    assert_eq(load8(wire + 3), 200, "motion y lo");
    assert_eq(load8(wire + 4), 0, "motion y hi");
    # resize (800, 600) → [0x10, w:u16 LE, h:u16 LE]
    assert_eq(shim_encode_resize(MehmanAbi.ABI_SWALLOW, 800, 600, wire), 5, "resize encodes to 5 bytes");
    assert_eq(load8(wire + 0), 0x10, "resize wire tag");
    assert_eq(load8(wire + 1), 32, "resize w lo (800 & 0xFF)");
    assert_eq(load8(wire + 2), 3, "resize w hi");
    assert_eq(load8(wire + 3), 88, "resize h lo (600 & 0xFF)");
    # lifecycle CLOSE → [0x20, 4]
    assert_eq(shim_encode_lifecycle(MehmanAbi.ABI_SWALLOW, MehmanLifecycle.LIFECYCLE_CLOSE, wire), 2, "lifecycle encodes to 2 bytes");
    assert_eq(load8(wire + 0), 0x20, "lifecycle wire tag");
    assert_eq(load8(wire + 1), 4, "lifecycle = CLOSE (4)");
    # unsupported ABI / null event encode nothing
    assert_eq(shim_encode_input(99, ke, wire), 0, "unknown ABI encodes 0 bytes");
    assert_eq(shim_encode_input(MehmanAbi.ABI_SWALLOW, 0, wire), 0, "null event encodes 0 bytes");

    # ----- guest.cyr — M4 guest lifecycle (spawn / map / run / evict) -----
    test_group("guest.cyr — M4 guest lifecycle");
    var lg = guest_spawn("/bin/echo M4", 8, 4);
    assert_neq(lg, 0, "guest_spawn builds a guest");
    assert_eq(guest_state(lg), MehmanGuestState.GUEST_CREATED, "spawned -> CREATED");
    assert_eq(guest_spec_is_valid(guest_spec(lg)), 1, "guest carries a valid spec");
    assert_eq(surface_is_valid(guest_surface(lg)), 1, "guest carries a valid surface");
    assert_eq(guest_exit_code(lg), 0 - 1, "exit code -1 before first run");
    # map: the compositor mapped a window
    assert_eq(guest_map(lg), MehmanError.OK, "map -> OK");
    assert_eq(guest_state(lg), MehmanGuestState.GUEST_MAPPED, "mapped -> MAPPED");
    # run: launch the guest + capture its surface
    assert_eq(guest_run(lg), MehmanError.OK, "run -> OK (launched + captured)");
    assert_eq(guest_state(lg), MehmanGuestState.GUEST_RUNNING, "ran -> RUNNING");
    var lgbuf = MehmanSurface_buffer(guest_surface(lg));
    assert_eq(load8(lgbuf + 0), 77, "captured byte 0 = 'M' (/bin/echo M4)");
    assert_eq(load8(lgbuf + 1), 52, "captured byte 1 = '4'");
    # evict: tear down under compositor control
    assert_eq(guest_evict(lg), MehmanError.OK, "evict -> OK");
    assert_eq(guest_state(lg), MehmanGuestState.GUEST_EVICTED, "evicted -> EVICTED");
    # an evicted guest rejects further map/run
    assert_eq(guest_map(lg), MehmanError.INVALID_SPEC, "map after evict rejected");
    assert_eq(guest_run(lg), MehmanError.INVALID_SPEC, "run after evict rejected");
    # spawn rejects a bad command / null guest ops
    assert_eq(guest_spawn("", 8, 4), 0, "spawn rejects empty command");
    assert_eq(guest_evict(0), MehmanError.INVALID_SPEC, "evict null guest rejected");

    # ----- guest.cyr — M3 live event delivery (persistent guest) -----
    test_group("guest.cyr — M3 live delivery (kavach persistent guest)");
    var dg = guest_spawn("/bin/cat", 8, 4);   # cat echoes stdin -> stdout
    assert_neq(dg, 0, "delivery guest spawns");
    # send before start is rejected (no live handle)
    assert_eq(guest_send_input(dg, shim_input_key(0x29, 1)), MehmanError.EXEC_FAILED, "send before start rejected");
    assert_eq(guest_start(dg), MehmanError.OK, "guest_start (persistent) -> OK");
    assert_eq(guest_state(dg), MehmanGuestState.GUEST_RUNNING, "started -> RUNNING");
    assert_neq(guest_handle(dg), 0, "live handle set");
    # deliver a key event (HID_ESC pressed) → shim wire [0x01,0x29,1] → cat echoes it
    assert_eq(guest_send_input(dg, shim_input_key(0x29, 1)), MehmanError.OK, "send input event -> OK");
    var dbuf = alloc(16);
    assert_eq(guest_read(dg, dbuf, 16), 3, "guest received the 3-byte input event (echoed)");
    assert_eq(load8(dbuf + 0), 0x01, "delivered byte 0 = key wire tag");
    assert_eq(load8(dbuf + 1), 0x29, "delivered byte 1 = HID_ESC");
    assert_eq(load8(dbuf + 2), 1, "delivered byte 2 = pressed");
    # evict terminates + reaps the live guest
    assert_eq(guest_evict(dg), MehmanError.OK, "evict -> OK");
    assert_eq(guest_handle(dg), 0, "handle cleared after evict");
    assert_eq(guest_state(dg), MehmanGuestState.GUEST_EVICTED, "evicted -> EVICTED");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
